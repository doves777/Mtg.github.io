# Cloud Postgres (recommended: Neon — see docs/architecture/database-hosting.md)
# Paste the connection string from Neon → Dashboard → Connection details.
# Prefer the **pooled** connection for the Next.js app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Local Docker / apt Postgres example (agent/dev only):
# DATABASE_URL=postgresql://cardshow:cardshow@127.0.0.1:5432/cardshow_dev
